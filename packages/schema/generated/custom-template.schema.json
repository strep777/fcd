{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "fpcad-template"
    },
    "formatVersion": {
      "type": "number",
      "const": 1
    },
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "unit": {
      "type": "string",
      "const": "mm"
    },
    "vertices": {
      "minItems": 4,
      "maxItems": 3000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "xMm": {
            "type": "number",
            "minimum": -1000000,
            "maximum": 1000000
          },
          "yMm": {
            "type": "number",
            "minimum": -1000000,
            "maximum": 1000000
          },
          "zMm": {
            "type": "number",
            "minimum": -1000000,
            "maximum": 1000000
          }
        },
        "required": [
          "id",
          "xMm",
          "yMm",
          "zMm"
        ],
        "additionalProperties": false
      }
    },
    "faces": {
      "minItems": 4,
      "maxItems": 5000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "vertices": {
            "type": "array",
            "prefixItems": [
              {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              }
            ],
            "items": false,
            "minItems": 3,
            "maxItems": 3
          },
          "region": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          }
        },
        "required": [
          "id",
          "vertices",
          "region"
        ],
        "additionalProperties": false
      }
    },
    "morphs": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "minWeight": {
            "type": "number",
            "minimum": -10,
            "maximum": 10
          },
          "maxWeight": {
            "type": "number",
            "minimum": -10,
            "maximum": 10
          },
          "defaultWeight": {
            "type": "number",
            "minimum": -10,
            "maximum": 10
          },
          "deltas": {
            "maxItems": 3000,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "xMm": {
                  "type": "number",
                  "minimum": -1000000,
                  "maximum": 1000000
                },
                "yMm": {
                  "type": "number",
                  "minimum": -1000000,
                  "maximum": 1000000
                },
                "zMm": {
                  "type": "number",
                  "minimum": -1000000,
                  "maximum": 1000000
                }
              },
              "required": [
                "id",
                "xMm",
                "yMm",
                "zMm"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "name",
          "minWeight",
          "maxWeight",
          "defaultWeight",
          "deltas"
        ],
        "additionalProperties": false
      }
    },
    "measurements": {
      "minItems": 1,
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "kind": {
            "type": "string",
            "enum": [
              "height",
              "loop"
            ]
          },
          "vertexIds": {
            "minItems": 2,
            "maxItems": 3000,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "targetMm": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 100000
          },
          "minMm": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 100000
          },
          "maxMm": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 100000
          },
          "toleranceMm": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 100
          }
        },
        "required": [
          "name",
          "kind",
          "vertexIds",
          "targetMm",
          "minMm",
          "maxMm",
          "toleranceMm"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "format",
    "formatVersion",
    "id",
    "name",
    "version",
    "license",
    "unit",
    "vertices",
    "faces",
    "morphs",
    "measurements"
  ],
  "additionalProperties": false
}
