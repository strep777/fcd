{
  "name": "furrypattern-cad",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "main": "dist/main/main.cjs",
  "packageManager": "npm@11.13.0",
  "scripts": {
    "bootstrap": "npm ci",
    "build": "node scripts/build.mjs",
    "build:rust": "node scripts/cargo.mjs build --release --locked",
    "typecheck": "vue-tsc --noEmit",
    "docs:check": "node scripts/check-docs.mjs",
    "test": "node scripts/test-unit.mjs",
    "test:rust": "node scripts/cargo.mjs test --workspace --locked",
    "test:e2e": "node tests/e2e.mjs",
    "check": "npm run typecheck && npm test && npm run test:rust",
    "start": "node scripts/start.mjs",
    "dev": "npm run build && npm start",
    "test:offline": "node tests/offline-e2e.mjs",
    "test:recovery": "node tests/recovery-e2e.mjs",
    "package": "npm run build:rust && npm run build && node scripts/package.mjs",
    "verify": "node scripts/verify.mjs",
    "test:advanced": "node tests/advanced-e2e.mjs",
    "test:manufacturing": "node tests/manufacturing-e2e.mjs",
    "test:mask": "node tests/mask-e2e.mjs",
    "test:template": "node tests/template-e2e.mjs",
    "test:completion": "node tests/completion-e2e.mjs",
    "test:large": "node tests/large-mesh-e2e.mjs",
    "test:cluster": "node tests/cluster-e2e.mjs",
    "test:picking": "node tests/picking-e2e.mjs",
    "test:ui": "node tests/ui-workflow-e2e.mjs",
    "test:resources": "node tests/resources-e2e.mjs",
    "test:inference": "node tests/inference-e2e.mjs",
    "test:dual": "node tests/real-dual-view-e2e.mjs",
    "test:audit": "node tests/audit-e2e.mjs",
    "test:desktop": "node scripts/test-desktop.mjs",
    "test:workflow": "node tests/workflow-pages-e2e.mjs",
    "test:cut-tools": "node tests/cut-tools-e2e.mjs",
    "test:guards": "node tests/operation-guards-e2e.mjs",
    "test:simple": "node tests/simple-markings-e2e.mjs",
    "test:lifecycle": "node tests/lifecycle-e2e.mjs",
    "test:cancel": "node tests/late-cancel-e2e.mjs",
    "test:extraction": "node tests/extraction-safety-e2e.mjs",
    "test:build": "node tests/build-output-e2e.mjs",
    "test:interactions": "node tests/workspace-interactions-e2e.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@pdf-lib/upng": "1.0.1",
    "@resvg/resvg-wasm": "2.6.2",
    "fflate": "0.8.3",
    "manifold-3d": "3.5.4",
    "pdf-lib": "1.17.1",
    "pinia": "4.0.3",
    "vue": "3.5.42",
    "zod": "4.6.2",
    "@gltf-transform/core": "4.5.1",
    "fast-xml-parser": "5.11.2"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@vitejs/plugin-vue": "5.2.4",
    "electron": "44.3.0",
    "esbuild": "0.28.2",
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11"
  }
}
