{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "width": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "height": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "pixels": {
      "type": "string",
      "maxLength": 16777216,
      "pattern": "^[01]+$"
    }
  },
  "required": [
    "width",
    "height",
    "pixels"
  ],
  "additionalProperties": false
}
