{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FurryPattern CAD",
  "version": "0.8.0",
  "identifier": "com.furrypattern.cad",
  "build": {
    "frontendDist": "../../../dist/renderer"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FurryPattern CAD",
        "width": 1440,
        "height": 960,
        "minWidth": 1000,
        "minHeight": 680,
        "visible": false,
        "dragDropEnabled": false,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; worker-src 'self' blob:; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "resources": {
      "../../../dist/main/": "dist/main/",
      "../../../dist/assets/": "dist/assets/",
      "../../../dist/bin/": "dist/bin/",
      "../../../dist/node_modules/": "dist/node_modules/",
      "../../../dist/THIRD_PARTY_NOTICES/": "THIRD_PARTY_NOTICES/"
    },
    "icon": [
      "icons/icon.ico"
    ]
  }
}
